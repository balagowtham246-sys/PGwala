# Copy this file to `.env.test` and populate non-production Supabase test credentials.
# Never commit `.env.test` (it is listed in .gitignore).
# Note: Only publishable/anon key + test user passwords are needed; never put service_role keys here.

SUPABASE_TEST_URL=https://your-project-ref.supabase.co
SUPABASE_TEST_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Property 1 (Primary) test users
TEST_OWNER_EMAIL=owner1@example.com
TEST_OWNER_PASSWORD=replace-me
TEST_WARDEN_EMAIL=warden1@example.com
TEST_WARDEN_PASSWORD=replace-me
TEST_RESIDENT_EMAIL=resident1@example.com
TEST_RESIDENT_PASSWORD=replace-me

# Cross-tenant isolation verification users (Property 2 / another resident)
TEST_OTHER_OWNER_EMAIL=owner2@example.com
TEST_OTHER_OWNER_PASSWORD=replace-me
TEST_OTHER_RESIDENT_EMAIL=resident2@example.com
TEST_OTHER_RESIDENT_PASSWORD=replace-me

