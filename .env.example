# Copy this file to `.env` and fill in your own values.
# Only use the PUBLISHABLE key here. Never put a secret / service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Sentry Crash Monitoring (Optional for dev, recommended for production builds)
EXPO_PUBLIC_SENTRY_DSN=

# PostHog Product Analytics
EXPO_PUBLIC_POSTHOG_PROJECT_TOKEN=phc_your_project_token_here
EXPO_PUBLIC_POSTHOG_HOST=https://your-posthog-host

